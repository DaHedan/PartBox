<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的背景层。

  与 assets/PartBox_logo_1024.png 的底色渐变严格对齐：logo 自身的渐变是
  #23305C（y=0）→ #1A243F（y=1023），前景里 logo 只占 108dp 画布的 66dp
  （上下各留 21dp），这里把同一条斜率的渐变外推到整块 108dp 画布，
  于是前景圆角的透明处露出的背景与 logo 边缘颜色连续，不会有接缝。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#FF172036"
        android:startColor="#FF263465"
        android:type="linear" />
</shape>
